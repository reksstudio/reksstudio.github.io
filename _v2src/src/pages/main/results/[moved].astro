---
import { moved, results } from '../../../lib/overview.mjs';

// one redirect page per moved slug -> anchor on the dissociation page
export function getStaticPaths() {
  return Object.entries(moved).map(([slug, anchor]) => {
    if (results.some((r) => r.slug === slug)) throw new Error(`overview.json: moved slug ${slug} is a results[] slug`);
    return { params: { moved: slug }, props: { anchor } };
  });
}

const { anchor } = Astro.props;
const target = `../dissociation/#${anchor}`;
const canonical = new URL(`${import.meta.env.BASE_URL}main/results/dissociation/`, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Moved — REKS Studio</title>
<meta http-equiv="refresh" content={`0; url=${target}`}>
<link rel="canonical" href={canonical}>
<meta name="robots" content="noindex">
</head>
<body><main><p><a href={target}>Bond dissociation: this result moved to the dissociation page →</a></p></main></body>
</html>
