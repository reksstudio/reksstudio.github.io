---
import { moved, results } from '../../../lib/overview.mjs';

// one redirect page per moved slug: a string -> anchor on the dissociation page; {to, text} -> results path
export function getStaticPaths() {
  return Object.entries(moved).map(([slug, m]) => {
    if (results.some((r) => r.slug === slug)) throw new Error(`overview.json: moved slug ${slug} is a results[] slug`);
    const to = typeof m === 'string' ? { path: 'dissociation/', anchor: `#${m}`, text: 'Bond dissociation: this result moved to the dissociation page' } : { path: m.to, anchor: '', text: m.text };
    return { params: { moved: slug }, props: to };
  });
}

const { path, anchor, text } = Astro.props;
const target = `../${path}${anchor}`;
const canonical = new URL(`${import.meta.env.BASE_URL}main/results/${path}`, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Moved — REKS Studio</title>
<meta http-equiv="refresh" content={`0; url=${target}`}>
<link rel="canonical" href={canonical}>
<meta name="robots" content="noindex">
</head>
<body><main><p><a href={target}>{text} →</a></p></main></body>
</html>
