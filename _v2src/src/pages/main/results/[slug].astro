---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import Block from '../../../components/main/Block.astro';
import Exits from '../../../components/main/Exits.astro';
import { classes, html, plain, resultHref, results } from '../../../lib/overview.mjs';
import '../../../styles/main.css';

// results with "page": true have their own page folder
export function getStaticPaths() {
  return results.filter((r) => !r.page).map((r) => ({ params: { slug: r.slug }, props: { r } }));
}

const base = import.meta.env.BASE_URL;
const { r } = Astro.props;
// blocks with "hidden": true in overview.json, or a title that resolves to '', are not built
const blocks = r.blocks.filter((b) => !b.hidden && b.title !== '');
const sections = blocks.filter((b) => b.id && b.title);
const parent = r.partOf && results.find((p) => p.slug === r.partOf);
---
<Base title={`${plain(r.title)} — REKS Studio`}>
<Nav variant="light" />
<main>

<header class="mhead">
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb"><a href={`${base}main/`}>Overview</a> › <a href={`${base}main/results/`}>Results</a> › <span set:html={html(r.short)} /></nav>
    <h1 set:html={html(r.title)} />
    <p class="ident" set:html={html(r.ident)} />
    <p class="refclass">Reference class: <Fragment set:html={html(classes[r.cls].label)} />{r.secondary && <>; secondary: <Fragment set:html={html(classes[r.secondary].label)} /></>}</p>
    <p class="keyline" set:html={html(r.key)} />
    {r.rule && <p class="rule" set:html={html(r.rule)} />}
    {parent && <p class="partof">Part of: <a href={resultHref(base, parent.slug)}><Fragment set:html={html(parent.short)} /> →</a></p>}
    {sections.length > 1 && <p class="sections">{sections.map((b, i) => <>{i > 0 && ' · '}<a href={`#${b.id}`} set:html={html(b.nav ?? b.title)} /></>)}</p>}
  </div>
</header>

<div class="wrap mbody">
  {blocks.map((b) => <Block block={b} />)}
  {r.scope && <p class="scope"><strong>Scope:</strong> <Fragment set:html={html(r.scope)} /></p>}
  <Exits r={r} />
</div>
</main>

<Footer />
</Base>
