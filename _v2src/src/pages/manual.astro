---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import FooterBack from '../components/FooterBack.astro';
import { Content, getHeadings } from '../content/manual.md';
import '../styles/docs.css';
import '../styles/manual.css';

const base = import.meta.env.BASE_URL;
const sections = getHeadings().filter((heading) => heading.depth === 2);
const navLinks = [
  { href: base, label: 'Overview' },
  { href: `${base}docs/`, label: 'Documentation' },
  { href: `#${sections[0].slug}`, label: 'Manual' },
];
---
<Base title="REKS Studio — User Manual">
<Nav variant="light" logoHref={base} links={navLinks} />

<header class="docshero">
  <div class="wrap">
    <div class="kicker">User Manual</div>
    <h1>REKS Studio — User Manual</h1>
    <p class="tagline">A guide to the REKS(N,M) / SA-REKS / SI-REKS implementation in Psi4</p>
    <p class="branch">(branch <code>kk/reks.studio</code>, repository <code>ConstLike/psi4</code>)</p>
    <div class="banner">Spin-Restricted Ensemble-referenced Kohn-Sham DFT — State-Averaged (SA) and State-Interaction (SI);<br>Konstantin Komarov, Michael Filatov, Seung Kyu Min,<br>Ulsan National Institute of Science and Technology (UNIST), South Korea</div>
  </div>
</header>

<div class="wrap">
  <div class="docs-layout">
    <div class="toc">
      {sections.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
    </div>

    <div>
      <Content />
    </div>
  </div>
</div>

<FooterBack href={`${base}docs/`} label="Back to REKS Studio documentation" />
</Base>
