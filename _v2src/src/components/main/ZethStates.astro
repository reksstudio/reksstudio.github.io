---
import Table from './Table.astro';
import { f1, letter } from '../../lib/ladder.mjs';

interface Props {
  c: any;
  // ladder set (lib/ladder.mjs ladderOf)
  set: any;
  // chart only the shown states below the largest energy gap between neighbouring levels
  low?: boolean;
}

// Panel per geometry: x = active space of the compound; a compound with one active space: one panel, x = geometry.
// y = E - E(zero) / unit in [0, ymax], ymax = highest charted state rounded up to grid (low: grid / 10^k, >= 2 steps)
const { c, set, low = false } = Astro.props;
const { geomsOf, level, levelTitle, noun, rungsOf, spins, unit, grid, zeroLabel } = set;
const rungs = rungsOf(c);
const gs = geomsOf(c);
const bySet = rungs.length === 1;
const NCOL = bySet ? gs.length : rungs.length;
const BW = 340;
const BL = 34;
// column pitch; 34 px margin right of the plot
const P = (BW - BL - 34) / NCOL;
const BT = 42;
const PH = 270;
const LW = 26;
const MINSEP = 5;
const LABSEP = 11;
// label advance at 11 px in viewBox units (mono)
const CHAR = 6.7;
// spin letter -> CSS class and chart order
const SPIN = Object.fromEntries(spins.map((sp) => [sp.letter, sp.cls]));
const ORDER = Object.fromEntries(spins.map((sp, i) => [sp.letter, i]));
const ev = (s) => s.v;
// shown states of a rung record with their chart value v / unit
const shown = (r) => r.states.filter((s) => s.eV != null).map((s) => ({ ...s, v: level(r, s) * unit.factor }));
const all = gs.flatMap((g) => Object.values(c.geoms[g.key].rungs).flatMap(shown)).sort((a, b) => ev(a) - ev(b));
let cut = Infinity;
if (low) {
  let k = 0;
  for (let i = 1; i < all.length; i++) if (ev(all[i]) - ev(all[i - 1]) > ev(all[k + 1]) - ev(all[k])) k = i - 1;
  cut = ev(all[k]);
}
const charted = (r) => shown(r).filter((s) => ev(s) <= cut);
const top = Math.max(...all.map(ev).filter((v) => v <= cut));
let step = grid;
while (low && top / step < 2) step /= 10;
const ymax = Math.ceil(top / step) * step;
const yv = (v) => BT + PH - (v / ymax) * PH;
const ticks = Array.from({ length: Math.round(ymax / step) + 1 }, (_, i) => i * step);
// states above the chart: labels and range
const above = all.filter((s) => ev(s) > cut);
const aboveLine = above.length > 0 && `${[...new Set(above.map((s) => s.label))].join(', ')} lie above the chart (${Math.round(ev(above[0]))} to ${Math.round(ev(above.at(-1)))} ${unit.label}); in the calculations below.`;

// columns of the panels: {i, key, lines (x label), g, rg, r}
const colsOf = (g) => {
  const rs = c.geoms[g.key].rungs;
  return (set.holes ? rungs : rungs.filter((rg) => rs[rg.key])).map((rg, i) => ({ i, key: rg.key, lines: [rg.label], g, rg, r: rs[rg.key] }));
};
const layout = bySet
  ? [{ g: null, name: rungs[0].ssr, tick: [rungs[0].ssr, ''], cols: gs.map((g, i) => ({ i, key: g.key, lines: g.plain.split(' · '), g, rg: rungs[0], r: c.geoms[g.key].rungs[rungs[0].key] })) }]
  : gs.map((g) => ({ g, name: g.plain, tick: g.tick, cols: colsOf(g) }));

// Levels closer than MINSEP px in a column share its width side by side (order S, T, Q, then energy);
// labels of the last computed column
const panels = layout.map(({ g, name, tick, cols }) => {
  const done = cols.filter((col) => col.r);
  const last = done.at(-1);
  const seg = {};
  const levels = [];
  let labels = [];
  for (const col of done) {
    const xl = BL + col.i * P + (P - LW) / 2;
    const groups = [];
    for (const s of [...charted(col.r)].sort((a, b) => ev(a) - ev(b))) {
      const gp = groups.at(-1);
      if (gp && yv(ev(gp.at(-1))) - yv(ev(s)) < MINSEP) gp.push(s);
      else groups.push([s]);
    }
    for (const gp of groups) {
      gp.sort((a, b) => ORDER[letter(a.label)] - ORDER[letter(b.label)] || ev(a) - ev(b));
      const w = (LW - 2 * (gp.length - 1)) / gp.length;
      gp.forEach((s, k) => {
        const x0 = xl + k * (w + 2);
        seg[`${col.key}|${s.label}`] = { x0, x1: x0 + w, y: yv(ev(s)) };
        levels.push({ s, col, x0, w, y: yv(ev(s)) });
      });
      if (col === last) {
        const y = gp.reduce((t, s) => t + yv(ev(s)), 0) / gp.length;
        labels.push({ y0: y, y, x: xl + LW, text: gp.map((s) => s.label).join('·') });
      }
    }
  }
  // symmetric push of neighbouring labels (y descending = energy ascending)
  for (let it = 0; it < 50; it++) {
    for (let k = 0; k + 1 < labels.length; k++) {
      const d = labels[k].y - labels[k + 1].y;
      if (d < LABSEP) {
        labels[k].y += (LABSEP - d) / 2;
        labels[k + 1].y -= (LABSEP - d) / 2;
      }
    }
  }
  // thread: right end of a level -> left end of its state.next partner in the next computed column (both charted)
  const threads = [];
  done.forEach((col, k) => {
    const nx = done[k + 1];
    if (!nx) return;
    for (const s of charted(col.r)) {
      const b = s.next && seg[`${nx.key}|${s.next}`];
      if (!b) continue;
      const a = seg[`${col.key}|${s.label}`];
      threads.push({ cls: SPIN[letter(s.label)], skip: nx.i - col.i > 1, d: `M${f1(a.x1)} ${f1(a.y)}L${f1(b.x0)} ${f1(b.y)}` });
    }
  });
  // threads table twin: one row per 2S and pair of adjacent computed active spaces
  const rows = bySet
    ? []
    : spins.flatMap(({ letter: L, s: twoS }) =>
        done.slice(0, -1).filter((col) => shown(col.r).some((s) => letter(s.label) === L)).map((col) => {
          const ts = shown(col.r).filter((s) => letter(s.label) === L && s.next).map((s) => `${s.label}→${s.next}`);
          return [twoS, `${col.rg.ssr} → ${done[done.indexOf(col) + 1].rg.ssr}`, ts.length ? ts.join(', ') : 'none'];
        }));
  return { g, name, tick, cols, levels, labels, threads, table: g && { title: `${g.markup}: threads`, head: ['2S', 'Active spaces', 'Threads'], rows } };
});
const longest = Math.max(...panels.flatMap((p) => p.labels.map((l) => l.text.length)));
const W = Math.max(BW, BL + NCOL * P - (P - LW) / 2 + 8 + CHAR * longest);
const H = BT + PH + 38;
---
<ul class="spin-legend qlegend">
  {spins.map((sp, i) => <>{i > 0 && ' '}<li class={sp.cls}><span class="sw"></span>2S = {sp.s}: {sp.shown}</li></>)}
</ul>
<div class="zgrid z3">
  {panels.map((p) => (
    <svg class="zc zb" viewBox={`0 0 ${f1(W)} ${H}`} role="img" aria-label={`${c.id} ${p.name}: SI states per ${bySet ? noun : 'active space'}, E − ${zeroLabel} / ${unit.label}, 0 to ${ymax}${bySet ? '' : ', joined across active spaces'}; numbers in the tables below`}>
      <text x="0" y="15" class="ttl">{p.tick[0]}{p.tick[1] && <tspan class="sb" dy="3">{p.tick[1]}</tspan>}</text>
      <text x="0" y={BT - 12} class="tick">E − {zeroLabel} / {unit.label}</text>
      {ticks.map((t) => (
        <g>
          <line x1={BL} x2={f1(BL + NCOL * P)} y1={f1(yv(t))} y2={f1(yv(t))} class="grid" />
          <text x={BL - 6} y={f1(yv(t) + 4)} text-anchor="end" class="tick">{t}</text>
        </g>
      ))}
      {p.cols.map((col) => (
        <>
          {col.lines.map((t, k) => <text x={f1(BL + col.i * P + P / 2)} y={BT + PH + 18 + 12 * k} text-anchor="middle" class={col.r ? 'tick' : 'tick nc'}>{t}</text>)}
          {!col.r && <text x={f1(BL + col.i * P + P / 2)} y={BT + PH + 30} text-anchor="middle" class="tick nc">–</text>}
        </>
      ))}
      {!bySet && set.names.ssr && <text x={f1(BL + (NCOL * P) / 2)} y={BT + PH + 32} text-anchor="middle" class="tick">{set.names.ssr} active space</text>}{p.threads.map((t) => <path class={`th ${t.cls}${t.skip ? ' sk' : ''}`} d={t.d} />)}
      {p.levels.map((l) => <path class={`lv ${SPIN[letter(l.s.label)]}`} d={`M${f1(l.x0)} ${f1(l.y)}h${f1(l.w)}`}><title>{levelTitle(c, l.col.g, l.col.rg, l.s)}</title></path>)}
      {p.labels.map((l) => (
        <>
          {Math.abs(l.y - l.y0) > 2 && <path class="ld" d={`M${f1(l.x + 1)} ${f1(l.y0)}L${f1(l.x + 5)} ${f1(l.y)}`} />}
          <text x={f1(l.x + 6)} y={f1(l.y + 3.8)} class="lab">{l.text}</text>
        </>
      ))}
    </svg>
  ))}
</div>{aboveLine && <p class="qcap">{aboveLine}</p>}
<slot name="caption"><p class="qcap">One column per active space and one level per SI state shown on this page at E − E(S0) / eV (same geometry and active space); colour = 2S; levels closer than about 0.08 eV sit side by side. A thin line joins a level to one level of the same 2S at the next computed active space when their leading excitation patterns agree (same dominant pattern, or pattern weights that overlap by at least one half) or their density changes ΔD differ by at most 0.15; the joins are one-to-one, as many as the rule allows. A level without a line has no such partner among the shown states. Patterns come from the leading configurations listed in the output (the three largest, then every further one above 5 %); at (8,8) and (10,10) these often carry a small share of the state, which the hover gives. ΔD: change of the active orbital occupations (diagonal of the active one-particle density) from S0. H−k … H, L … L+k: bonding and antibonding active orbitals in pair order, H and L the frontier pair; H→L moves one electron, H,H→L,L two. –: not computed, a dashed line spans it; Q1 at (2,2): n/a. Spin gaps on this page in kcal mol⁻¹, SI state energies in eV; the T1 level of each column is E(T1) − E(S0).</p></slot>
{panels.some((p) => p.table?.rows.length > 0) && (
  <details class="qmore">
    <summary>Table: threads per {noun}</summary>
    {panels.map((p) => <Table table={p.table} grouped />)}
  </details>
)}
