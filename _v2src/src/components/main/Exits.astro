---
import { html, manualHref, resultHref, results } from '../../lib/overview.mjs';

interface Props {
  r: any;
}

const base = import.meta.env.BASE_URL;
const { r } = Astro.props;
const x = r.exits ?? {};
const siblings = results.filter((s) => s.slug !== r.slug);
---
<section class="exits" id="exits">
  <h2>Run, ask, cite</h2>
  <ul>
    {x.input && <li>Input: <a href={`${base}${x.input}`}>{x.input.split('/').at(-1)}</a></li>}
    {x.notInstalled && <li><Fragment set:html={html(x.notInstalled)} /> Ask via <a href={`${base}docs/#contact`}>Contact</a>.</li>}
    {x.inputTodo && <li>Input: <span class="ph">to be added</span>.</li>}
    {x.manual && <li>Manual: <a href={manualHref(base, x.manual)}>worked inputs and checks</a></li>}
    <li><a href={manualHref(base, 'overview')}>Manual: Start</a> · <a href={`${base}docs/#install`}>Install</a> · <a href={`${base}docs/#cite`}>Cite</a> · <a href={`${base}docs/#contact`}>Contact</a></li>
    <li><a href={`${base}main/results/#row-${r.slug}`}>Back to the Results index</a></li>
  </ul>
  <p class="siblings">Other results: {siblings.map((s, i) => <>{i > 0 && ' · '}<a href={resultHref(base, s.slug)} set:html={html(s.short)} /></>)}</p>
</section>
