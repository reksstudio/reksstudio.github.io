---
import { html, landing, plain, resultHref } from '../../lib/overview.mjs';
import { cards as data, mini, sub } from '../../lib/dissoc.mjs';

const base = import.meta.env.BASE_URL;
const { trust, demos, bridge } = landing.proof;
// card values from the dissociation data; a table card without rows is not rendered
const cards = landing.proof.cards
  .map((c) => ({ ...c, ...(c.kind === 'band' ? data.band : c.kind === 'table' ? { table: data.table } : { curves: data.curves }) }))
  .filter((c) => c.kind !== 'table' || c.table);
// value axis spans 8 to W - 8
const W = 240;
const H = 72;
const ax = (c) => (v) => 8 + ((v - c.axis[0]) / (c.axis[1] - c.axis[0])) * (W - 16);
// tick values at multiples of step inside the axis range
const ticks = (c) => {
  const [a, b] = c.axis;
  const step = b - a > 2 ? 1 : 0.5;
  return Array.from({ length: Math.floor(b / step) - Math.ceil(a / step) + 1 }, (_, k) => (Math.ceil(a / step) + k) * step);
};
const aria = (c) => {
  if (c.kind === 'band') return `REKS Studio ${c.ours} eV, ${plain(c.ref_name)}`;
  if (c.kind === 'table') return `REKS Studio against ${plain(c.ref_name)}: ${c.table.rows.map(([m, o, r]) => `${plain(m)} ${o} vs ${r}`).join(', ')}`;
  return `Potential energy curves of ${c.curves.map((k) => plain(k.id)).join(', ')}: REKS Studio and ${plain(c.ref_name)}`;
};
// mini curves: n panels of width (W - 8 (n - 1)) / n, height 44 from y 4; SSR and FCI share one Eh scale per panel
const minis = (c) => {
  const n = c.curves.length;
  const w = (W - 8 * (n - 1)) / n;
  return c.curves.map((s, i) => ({ name: s.id, mid: i * (w + 8) + w / 2, ...mini(s, i * (w + 8), w, 44, 4) }));
};
---
<div class="pcards">
  {cards.map((c) => {
    const X = c.axis && ax(c);
    return (
      <div class="pcard">
        <a class="pq" href={resultHref(base, c.slug, c.anchor)} set:html={html(c.problem)} />
        {c.kind === 'table'
          ? (
            <table class="ptab" aria-label={aria(c)}>
              <thead><tr>{c.table.head.map((h) => <th>{h}</th>)}</tr></thead>
              <tbody>{c.table.rows.map(([m, o, r]) => <tr><th set:html={html(m)} /><td>{o}</td><td>{r}</td></tr>)}</tbody>
            </table>
          )
          : (
            <svg class="pviz" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria(c)}>
              {c.kind === 'band' && (
                <>
                  <rect x={X(c.ref - c.err)} y="20" width={X(c.ref + c.err) - X(c.ref - c.err)} height="20" class="err" />
                  <line x1="8" x2={W - 8} y1="30" y2="30" class="axis" />
                  <circle cx={X(c.ref)} cy="30" r="6" class="ref" />
                  <circle cx={X(c.ours)} cy="30" r="5" class="ours" />
                  {ticks(c).map((v) => <text x={X(v)} y="62" text-anchor="middle" class="tick">{v.toFixed(1)}</text>)}
                </>
              )}
              {c.kind === 'curves' && minis(c).map((k) => (
                <g>
                  <g class="x10" transform="scale(.1)"><path d={k.fci} class="fci" /><path d={k.ssr} class="ssr" /></g>
                  <text x={k.mid} y="67" text-anchor="middle" class="tick mn" set:html={sub(k.name)} />
                </g>
              ))}
            </svg>
          )}
        {c.big && <span class="pbig" set:html={html(c.big)} />}
        <span class="pref">vs <Fragment set:html={html(c.ref_name)} /></span>
        <span class="psub" set:html={html(c.sub)} />
      </div>
    );
  })}
</div>
<p class="ptrust"><a href={resultHref(base, trust.slug, trust.anchor)}><Fragment set:html={html(trust.t)} /> →</a></p>
<p class="pdemo"><span>Beyond available references:</span> {demos.map((d, i) => <>{i > 0 && ' · '}<a href={resultHref(base, d.slug)} set:html={html(d.t)} /></>)} →</p>
<p class="pall"><a href={`${base}main/results/`}>All comparisons →</a></p>
<p class="bridge"><a href="#cost">{bridge} ↓</a></p>
