---
interface Pic { src: string; w: number; h: number; alt: string }
interface Line { q?: string; v: string; ref?: string; sub?: string }
interface Link { href: string; t: string }
interface Props {
  pics: Pic[];
  title: string;
  lines?: Line[];
  cond?: string;
  links: { label?: string; ls: Link[] }[];
}

const { pics, title, lines = [], cond, links } = Astro.props;
const base = import.meta.env.BASE_URL;
// published drawings at twice their stored size, one scale per card, the tallest at most PH px
const PH = 80;
const k = Math.min(2, PH / Math.max(...pics.map((p) => p.h)));
---
<li class="hcard">
  <div class="hc-pic">{pics.map((p) => <img src={`${base}${p.src}`} width={Math.round(p.w * k)} height={Math.round(p.h * k)} alt={p.alt} loading="lazy" decoding="async" />)}</div>
  <h3 set:html={title} />
  {lines.length > 0 && (
    <dl class="hc-ls">{lines.map((l) => (
      <div class="hc-l">
        {l.q && <dt set:html={l.q} />}
        <dd class="hc-v" set:html={l.v} />
        {l.ref && <dd class="hc-ref" set:html={l.ref} />}
        {l.sub && <dd class="hc-ref" set:html={l.sub} />}
      </div>
    ))}</dl>
  )}
  {cond && <p class="hc-c" set:html={cond} />}
  <div class="hc-as">{links.map((r) => <p class="hc-a">{r.label && <span class="hc-al">{r.label}</span>}{r.ls.map((l) => <a href={l.href} set:html={l.t} />)}</p>)}</div>
</li>
