---
import { html, landing, plain, resultHref } from '../../lib/overview.mjs';
import { hero } from '../../lib/dissoc.mjs';

interface Props {
  window?: [number, number];
}

const base = import.meta.env.BASE_URL;
const { caption, callout } = landing.hero;
const { window: [r0, r1] = [0.5, 3.5] } = Astro.props;
// raw H2 series cut to the R window; E window from the cut series
const cut = (c) => c.filter(([r]) => r >= r0 - 1e-9 && r <= r1 + 1e-9);
const curve = { ks: cut(hero.ks), ssr: cut(hero.ssr), fci: cut(hero.fci) };
const all = [...curve.ks, ...curve.ssr, ...curve.fci].map(([, e]) => e);
const span = Math.max(...all) - Math.min(...all);
const [e0, e1] = [Math.min(...all) - 0.06 * span, Math.max(...all) + 0.15 * span];
const W = 520;
const H = 330;
// left margin holds the axis title "E / Eh" right-aligned at L - 6
const [L, R, T, B] = [66, 12, 14, 40];
const x = (r) => L + ((r - r0) / (r1 - r0)) * (W - L - R);
const y = (e) => T + ((e1 - e) / (e1 - e0)) * (H - T - B);
const pts = (c) => c.map(([r, e]) => `${x(r).toFixed(1)},${y(e).toFixed(1)}`).join(' ');
const at = (c, r) => c.find((p) => Math.abs(p[0] - r) < 1e-9)[1];
const end = (c) => c.at(-1)[1];
const f4 = (v) => v.toFixed(4);
// grid at multiples of 0.1 Eh inside the window; R ticks at whole Angstrom
const grid = Array.from({ length: Math.floor(e1 * 10) - Math.ceil(e0 * 10) + 1 }, (_, k) => (Math.ceil(e0 * 10) + k) / 10);
const rt = Array.from({ length: Math.floor(r1) - Math.ceil(r0) + 1 }, (_, k) => Math.ceil(r0) + k);
// callout: KS and FCI at the stretched point
const rc = 2.5;
const label = `H2 dissociation energy against H–H distance, ${r0} to ${r1} Å: ordinary DFT (RKS) rises to ${f4(end(curve.ks))} Eh at ${r1} Å, exact FCI and REKS Studio (SSR) level off near ${f4(end(curve.fci))} and ${f4(end(curve.ssr))} Eh. ${plain(caption)}.`;
---
<figure class="hcurve">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
    {grid.map((e) => (
      <g>
        <line x1={L} x2={W - R} y1={y(e)} y2={y(e)} class="grid" />
        <text x={L - 6} y={y(e) + 5} text-anchor="end" class="tick">{e.toFixed(1)}</text>
      </g>
    ))}
    {rt.map((r) => <text x={x(r)} y={H - B + 20} text-anchor="middle" class="tick">{r}</text>)}
    <text x={W - R} y={H - 4} text-anchor="end" class="tick">R(H–H) / Å</text>
    <text x={L - 6} y={T + 4} text-anchor="end" class="tick">E / E<tspan dy="4" font-size="11">h</tspan></text>
    <polyline points={pts(curve.ks)} class="ks" />
    <polyline points={pts(curve.ssr)} class="ssr" />
    <polyline points={pts(curve.fci)} class="fci" />
    <text x={W - R} y={y(end(curve.ks)) - 10} text-anchor="end" class="lab ks-l">ordinary DFT (RKS)</text>
    <text x={W - R} y={y(end(curve.ssr)) - 10} text-anchor="end" class="lab ssr-l">REKS Studio</text>
    <text x={W - R} y={y(end(curve.fci)) + 22} text-anchor="end" class="lab">exact (FCI)</text>
    <line x1={x(rc)} x2={x(rc)} y1={y(at(curve.ks, rc)) + 4} y2={y(at(curve.fci, rc)) - 4} class="call" />
    <circle cx={x(rc)} cy={y(at(curve.ks, rc))} r="4" class="call-dot" />
    <text x={x(rc) - 10} y={y(at(curve.ks, rc)) - 14} text-anchor="end" class="lab call-l">{callout}</text>
  </svg>
  <figcaption><a href={resultHref(base, 'dissociation', 'h2')}><Fragment set:html={html(caption)} /> →</a></figcaption>
</figure>
