---
import { history } from '../../lib/overview.mjs';

// step line: largest active space (orbitals M) reported per paper, by year; the generated reach as a separate marker
const W = 640;
const H = 260;
const L = 44;
const R = 16;
const B = 36;
const T = 16;
const [y0, y1] = [1998, 2027];
const x = (yr) => L + ((yr - y0) / (y1 - y0)) * (W - L - R);
const y = (m) => H - B - (m / 12) * (H - B - T);
const s = history.steps;
const path = `M${x(s[0].year)} ${y(s[0].m)} ${s.slice(1).map((p) => `H${x(p.year)} V${y(p.m)}`).join(' ')} H${x(y1)}`;
const g = history.generated;
const label = `Largest active space reported per paper, by year: ${s.map((p) => `${p.year} ${p.label}`).join(', ')}; ${g.year} ${g.label} (separate marker)`;
---
<svg class="step-chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
  {[2, 4, 6, 8, 10, 12].map((m) => (
    <g>
      <line x1={L} x2={W - R} y1={y(m)} y2={y(m)} class="grid" />
      <text x={L - 6} y={y(m) + 4} text-anchor="end" class="tick">{m}</text>
    </g>
  ))}
  {[2000, 2005, 2010, 2015, 2020, 2025].map((yr) => <text x={x(yr)} y={H - B + 18} text-anchor="middle" class="tick">{yr}</text>)}
  <text x={L} y={T - 4} class="tick">M (orbitals = electrons), reported</text>
  <path d={path} class="step" />
  {s.map((p) => (
    <g>
      <circle cx={x(p.year)} cy={y(p.m)} r="4" class="pt" />
      <text x={x(p.year) - 6} y={y(p.m) - 8} text-anchor="end" class="val">{p.label}</text>
    </g>
  ))}
  <circle cx={x(g.year)} cy={y(g.m)} r="5" class="gen" />
  <text x={x(g.year) - 8} y={y(g.m) + 4} text-anchor="end" class="val">{g.label}</text>
</svg>
