---
import { codeHtml, digitGroups, groupCount } from '../../lib/inline.mjs';
import { cellHtml, html } from '../../lib/overview.mjs';

type Cell = string | { t: string; manual?: string; href?: string; lit?: boolean };

interface Props {
  table: { title?: string; head: Cell[]; rows: Cell[][] };
  numeric?: boolean;
  grouped?: boolean;
  ruler?: string;
}

const base = import.meta.env.BASE_URL;
const { table, numeric, grouped, ruler } = Astro.props;
const key = (c: Cell) => (typeof c === 'string' ? c : c.t);
// literature cell {t, lit: true, href?}: text as printed (escaped, _{x} / ^{x} only), marked data-lit
const lit = (c: Cell) => (typeof c === 'object' && c.lit ? '' : undefined);
const litBody = (c: { t: string; href?: string }) => (c.href ? `<a href="${base}${c.href}">${codeHtml(c.t)}</a>` : codeHtml(c.t));
const body = (c: Cell) => (lit(c) === undefined ? cellHtml(c, base) : litBody(c as { t: string; href?: string }));
const head = (c: Cell) => (lit(c) === undefined ? html(key(c)) : codeHtml(key(c)));
// grouped: consecutive rows with the same first cell form one tbody, the first cell spans the group
const groups = grouped
  ? table.rows.reduce((acc: Cell[][][], row) => {
      const g = acc[acc.length - 1];
      if (g && key(g[0][0]) === key(row[0])) g.push(row);
      else acc.push([row]);
      return acc;
    }, [])
  : [];
const cls = [numeric && 'num', grouped && 'grp'].filter(Boolean).join(' ') || undefined;
// ruler: column whose digit groups are labelled in a footer row
const rulerCol = ruler ? table.head.findIndex((h) => key(h) === ruler) : -1;
if (ruler && rulerCol < 0) throw new Error(`Table: no column ${ruler}`);
const marks = ruler ? digitGroups(Math.max(...table.rows.map((r) => groupCount(key(r[rulerCol]))))) : [];
---
{table.title && <p class="tbl-title" set:html={html(table.title)} />}
<div class="tbl">
  <table class={cls}>
    <thead><tr>{table.head.map((h) => <th data-lit={lit(h)} set:html={head(h)} />)}</tr></thead>
    {grouped
      ? groups.map((g) => (
          <tbody>
            {g.map((row, i) => (
              <tr>
                {i === 0 && <th scope="rowgroup" rowspan={g.length} set:html={cellHtml(row[0], base)} />}
                {row.slice(1).map((c) => <td set:html={cellHtml(c, base)} />)}
              </tr>
            ))}
          </tbody>
        ))
      : <tbody>{table.rows.map((row) => <tr>{row.map((c) => <td data-lit={lit(c)} set:html={body(c)} />)}</tr>)}</tbody>}
    {ruler && (
      <tfoot class="eruler" aria-hidden="true">
        <tr>{table.head.map((_, c) => <td>{c === rulerCol && marks.map((m) => <><span><b>000</b><i>{m}</i></span>{' '}</>)}</td>)}</tr>
      </tfoot>
    )}
  </table>
</div>
