---
import QuestElements from './QuestElements.astro';
import { html } from '../../lib/overview.mjs';
import { cardTable, elementsOf, mini, sysHref, systems, uni } from '../../lib/dissoc.mjs';

const base = import.meta.env.BASE_URL;
const elements = [...new Set(systems.flatMap(elementsOf))].sort((a, b) => (a === 'H') - (b === 'H'));
// chain card: mini curve SSR S0 against FCI on one Eh scale, MW x MH viewBox units
const MW = 160;
const MH = 40;
---
<ul class="qcards zcards">
  {systems.map((s) => {
    const m = s.kind === 'chain' && mini(s, 4, MW - 8, MH - 8, 4);
    const t = s.kind === 'molecule' && cardTable(s);
    return (
      <li class="qcard dcard" id={`c-${s.slug}`}>
        <a class="qimg" href={`#${s.slug}`}><img src={`${base}${s.svg}`} width={s.w} height={s.h} alt={`${uni(s.id)}: drawing at R_e of S0`} loading="lazy" decoding="async" /></a>
        <p class="qname"><a href={sysHref(s)} set:html={html(s.id)} /> <span>SSR{s.as}</span></p>
        {m
          ? (
            <svg class="pviz dmini" viewBox={`0 0 ${MW} ${MH}`} role="img" aria-label={`${uni(s.id)}: SSR S0${m.fci ? ' and FCI in the same basis' : ''} along R`}>
              <g class="x10" transform="scale(.1)">{m.fci && <path d={m.fci} class="fci" />}<path d={m.ssr} class="ssr" /></g>
            </svg>
          )
          : (
            <table>
              <thead><tr>{t.head.map((h) => <th set:html={html(h)} />)}</tr></thead>
              <tbody>{t.rows.map((r) => <tr>{r.map((c, i) => (i === 0 ? <th set:html={html(c)} /> : <td set:html={html(c)} />))}</tr>)}</tbody>
            </table>
          )}
        {m && <p class="dmk">{m.fci ? 'SSR vs FCI, same basis' : 'SSR; FCI out of reach'}</p>}
      </li>
    );
  })}
</ul>
<QuestElements elements={elements} />
<p class="qcap">Each card leads to its curve; each system page holds the stored SI states and the per-point data.</p>
