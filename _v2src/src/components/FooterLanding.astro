---
const base = import.meta.env.BASE_URL;
---
<footer id="cite" class="foot-landing">
  <div class="wrap">
    <div class="foot-cols">
      <div>
        <div class="foot-label">CONTACT</div>
        <a href="mailto:reks.studio1@gmail.com">Contact Support Team</a>
      </div>
      <div>
        <div class="foot-label">Team</div>
        <div class="cite-block">
          <p style="margin-top:24px; font-size:0.92rem;"><a href={`${base}team/`} style="color:var(--blue); text-decoration:underline;">Members</a></p>
        </div>
      </div>
      <div>
        <div class="foot-label">LINKS</div>
        <a href="https://github.com/ConstLike/psi4/tree/kk/reks.studio" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={`${base}docs/`}>Documentation</a>
        <a href="https://chemrxiv.org/doi/full/10.26434/chemrxiv.15008475/v1" target="_blank" rel="noopener noreferrer">Paper</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>Copyright © 2026, REKS Studio developers</span>
      <span>Site built with plain HTML &amp; CSS</span>
    </div>
  </div>
</footer>
