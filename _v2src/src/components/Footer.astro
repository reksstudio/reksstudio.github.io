---
import { SOURCE_URL } from '../lib/site.mjs';
import { doiUrl, reference } from '../lib/literature.mjs';

const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}docs/#contact`, label: 'Contact' },
  { href: `${base}docs/#cite`, label: 'Cite' },
  { href: `${base}docs/#licence`, label: 'Licence' },
  { href: SOURCE_URL, label: 'GitHub', external: true },
  { href: doiUrl(reference('komarov2026-reks-studio')), label: 'Paper', external: true },
  { href: `${base}team/`, label: 'Team' },
];
---
<footer class="foot">
  <div class="wrap">
    {links.map((l) => l.external
      ? <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
      : <a href={l.href}>{l.label}</a>)}
  </div>
</footer>
