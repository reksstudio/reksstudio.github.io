---
interface Props {
  variant: 'dark' | 'light';
  logoHref?: string;
}

const base = import.meta.env.BASE_URL;
const { variant, logoHref = base } = Astro.props;
// one list on every page; the current section is the longest href that prefixes the page path
const links = [
  { href: base, label: 'Overview' },
  { href: `${base}docs/`, label: 'Documentation' },
  { href: `${base}manual/`, label: 'Manual' },
  { href: `${base}team/`, label: 'Team' },
];
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const current = links.filter((l) => path.startsWith(l.href)).at(-1);
---
<nav class={`nav-${variant}`}>
  <div class="wrap">
    <a class="logo" href={logoHref}>REKS<span class="dot">·</span>Studio</a>
    <div class="navlinks">
      {links.map((link) => <a href={link.href} aria-current={link === current ? 'page' : undefined}>{link.label}</a>)}
    </div>
  </div>
</nav>
